# Copie para backend/.env em desenvolvimento. NUNCA versione o .env.

APP_ENV=development
# Obrigatória em produção (mínimo 32 caracteres). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Superadministrador da plataforma (opcional; senha com 12+ caracteres)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cadastro público de novos RPPS (padrão: ligado em dev, desligado em produção)
ALLOW_SIGNUP=true

# IA — chamadas diretas, sem intermediários
AI_PROVIDER=auto            # auto | openai | anthropic
OPENAI_API_KEY=             # necessária para a transcrição de áudio
OPENAI_MODEL=gpt-4.1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
TRANSCRIPTION_MODEL=whisper-1

# Armazenamento local
DATABASE_PATH=./data/atas.db
UPLOAD_DIR=./data/uploads
